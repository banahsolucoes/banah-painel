# Copie para .env (local) e preencha. Em staging/produção, estes nomes vão
# nas variáveis de ambiente do Vercel. Valores reais NUNCA entram no Git.

# local | staging | production
APP_ENV=local
APP_URL=http://localhost:3000

# Banco (Supabase). Em serverless use a URL do pooler (porta 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase (login dos usuários)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App BANAH no DevCenter do Mercado Livre (um por ambiente)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:3000/api/auth/ml/callback

# Chave de 32 bytes em base64 para cifrar tokens dos clientes.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Segredo que o Vercel Cron envia em Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# IA (usada só pelos agentes, a partir da Fase 4)
ANTHROPIC_API_KEY=

# true = agentes registram a ação mas não enviam ao marketplace
AGENTS_DRY_RUN=true

# E-mails com papel admin (Israel). Separados por vírgula.
ADMIN_EMAILS=banahsolucoes@gmail.com
